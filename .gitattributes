# Normalise text files to LF in the repository.
* text=auto

# Shell scripts must stay LF on every checkout, including Windows with core.autocrlf=true;
# CRLF breaks bash on macOS and Linux (scripts/tests checks this).
*.sh text eol=lf

# PowerShell scripts are fine either way; keep Windows-style line endings on checkout.
*.ps1 text eol=crlf

# Binary files that git should never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.npz binary
*.parquet binary
