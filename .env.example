# Copy to .env and adjust per machine. Never commit .env.

WT_ENV=dev
WT_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=wildtriage
# Native runs (no Docker) use a local URL instead:
# WT_DATABASE_URL=postgresql+psycopg://wildtriage:wildtriage@localhost:5432/wildtriage
# WT_MEDIA_ROOT=D:/wildtriage-data/media          (Windows)
# WT_MEDIA_ROOT=/Users/<you>/wildtriage-data/media  (macOS)

# Models: "stub" on the Windows laptop (no GPU); "real" on the lab PC, the T1000 machine and the MacBook.
WT_MODEL_BACKEND=stub
# Device: auto picks cuda, then mps (Apple silicon), then cpu. Pin it with cuda / mps / cpu if needed.
WT_DEVICE=auto
# Accelerator memory budget per machine (GB):
#   lab PC (RTX 4000 Ada, 20 GB) 18 · T1000 (4 GB) 3.5 · MacBook M1 Pro (32 GB unified memory) 12
WT_GPU_VRAM_BUDGET_GB=18
# Hugging Face token for gated SAM 3 / SA-FARI downloads (after access is granted).
HF_TOKEN=

# true = refuse non-commercial models/datasets (see ml/models.yaml).
WT_COMMERCIAL_MODE=false
